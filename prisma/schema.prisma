// Prisma Schema for LINE-Style Chat Application
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ========================================
// User Management
// ========================================

model User {
  id               String    @id @default(uuid())
  lineId           String    @unique // LINE ID สำหรับเพิ่มเพื่อน (e.g., @username)
  email            String?   @unique
  phoneNumber      String?   @unique
  passwordHash     String?
  displayName      String
  profileImage     String?   // URL to profile image
  coverImage       String?   // URL to cover photo
  statusMessage    String?   // สถานะ (e.g., "Available", "Busy")
  qrCode           String?   // QR Code data for adding friends
  isOnline         Boolean   @default(false)
  lastSeen         DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // OAuth providers
  emailVerified    DateTime?
  accounts         Account[]
  sessions         Session[]

  // Relations
  sentFriendRequests      Friendship[]  @relation("UserSentRequests")
  receivedFriendRequests  Friendship[]  @relation("UserReceivedRequests")
  conversations           ConversationParticipant[]
  messages                Message[]
  readReceipts            MessageReadReceipt[]
  stickerPacks            UserStickerPack[]
  posts                   Post[]
  postLikes               PostLike[]
  postComments            PostComment[]
  initiatedCalls          Call[]
  callParticipations      CallParticipant[]
  notifications           Notification[]
  createdConversations    Conversation[] @relation("ConversationCreator")

  @@index([lineId])
  @@index([email])
  @@index([phoneNumber])
  @@map("users")
}

// NextAuth.js required models
model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ========================================
// Friend System
// ========================================

enum FriendshipStatus {
  PENDING   // รอการยอมรับ
  ACCEPTED  // เป็นเพื่อนแล้ว
  BLOCKED   // บล็อก
}

model Friendship {
  id          String           @id @default(uuid())
  userId      String
  friendId    String
  status      FriendshipStatus @default(PENDING)
  isFavorite  Boolean          @default(false) // เพื่อนสนิท
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user   User @relation("UserSentRequests", fields: [userId], references: [id], onDelete: Cascade)
  friend User @relation("UserReceivedRequests", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
  @@index([userId])
  @@index([friendId])
  @@index([status])
  @@map("friendships")
}

// ========================================
// Conversations & Messages
// ========================================

enum ConversationType {
  DIRECT // 1:1 chat
  GROUP  // Group chat
}

model Conversation {
  id          String           @id @default(uuid())
  type        ConversationType
  name        String?          // ชื่อกลุ่ม (null สำหรับ DIRECT)
  imageUrl    String?          // รูปกลุ่ม
  createdById String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  createdBy    User                      @relation("ConversationCreator", fields: [createdById], references: [id])
  participants ConversationParticipant[]
  messages     Message[]
  calls        Call[]

  @@index([type])
  @@index([createdById])
  @@map("conversations")
}

enum ParticipantRole {
  ADMIN  // ผู้ดูแลกลุ่ม
  MEMBER // สมาชิกทั่วไป
}

model ConversationParticipant {
  id             String          @id @default(uuid())
  conversationId String
  userId         String
  role           ParticipantRole @default(MEMBER)
  joinedAt       DateTime        @default(now())
  lastReadAt     DateTime?       // อ่านถึงข้อความไหนแล้ว
  isMuted        Boolean         @default(false) // ปิดเสียงแจ้งเตือน
  isPinned       Boolean         @default(false) // ปักหมุดแชท
  leftAt         DateTime?       // เวลาออกจากกลุ่ม (null = ยังอยู่)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
  @@map("conversation_participants")
}

enum MessageType {
  TEXT     // ข้อความธรรมดา
  IMAGE    // รูปภาพ
  VIDEO    // วิดีโอ
  FILE     // ไฟล์
  STICKER  // สติ๊กเกอร์
  VOICE    // ข้อความเสียง
  LOCATION // ตำแหน่ง
}

model Message {
  id             String      @id @default(uuid())
  conversationId String
  senderId       String
  content        String      @db.Text
  type           MessageType @default(TEXT)

  // File attachments
  fileUrl        String?
  fileName       String?
  fileSize       Int?        // bytes

  // Sticker
  stickerId      String?

  // Reply/Forward
  replyToId      String?     // ตอบกลับข้อความนี้

  // Deletion
  isDeleted      Boolean     @default(false)
  deletedFor     String[]    @default([]) // User IDs ที่ลบข้อความนี้

  // Pin
  isPinned       Boolean     @default(false)

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  conversation Conversation         @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User                 @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyTo      Message?             @relation("MessageReplies", fields: [replyToId], references: [id])
  replies      Message[]            @relation("MessageReplies")
  readReceipts MessageReadReceipt[]
  sticker      Sticker?             @relation(fields: [stickerId], references: [id])

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([type])
  @@map("messages")
}

model MessageReadReceipt {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  readAt    DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
  @@map("message_read_receipts")
}

// ========================================
// Stickers
// ========================================

model StickerPack {
  id          String   @id @default(uuid())
  name        String
  description String   @db.Text
  coverImage  String
  price       Decimal  @default(0) @db.Decimal(10, 2) // 0 = ฟรี
  isOfficial  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stickers Sticker[]
  users    UserStickerPack[]

  @@map("sticker_packs")
}

model Sticker {
  id       String @id @default(uuid())
  packId   String
  imageUrl String
  order    Int    @default(0)

  pack     StickerPack @relation(fields: [packId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([packId])
  @@map("stickers")
}

model UserStickerPack {
  id          String   @id @default(uuid())
  userId      String
  packId      String
  purchasedAt DateTime @default(now())

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  pack StickerPack @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@unique([userId, packId])
  @@index([userId])
  @@map("user_sticker_packs")
}

// ========================================
// Timeline/Posts
// ========================================

enum PostVisibility {
  PUBLIC  // สาธารณะ
  FRIENDS // เฉพาะเพื่อน
  PRIVATE // ส่วนตัว
}

model Post {
  id            String         @id @default(uuid())
  userId        String
  content       String         @db.Text
  imageUrls     String[]       @default([]) // Array of image URLs
  visibility    PostVisibility @default(FRIENDS)
  likesCount    Int            @default(0)
  commentsCount Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes    PostLike[]
  comments PostComment[]

  @@index([userId, createdAt])
  @@index([visibility])
  @@map("posts")
}

model PostLike {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
  @@map("post_likes")
}

model PostComment {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([userId])
  @@map("post_comments")
}

// ========================================
// Voice/Video Calls
// ========================================

enum CallType {
  VOICE // โทรเสียง
  VIDEO // วิดีโอคอล
}

enum CallStatus {
  CALLING // กำลังเรียก
  ONGOING // กำลังคุย
  ENDED   // จบแล้ว
  MISSED  // ไม่รับสาย
}

model Call {
  id             String     @id @default(uuid())
  conversationId String
  initiatorId    String
  type           CallType
  status         CallStatus @default(CALLING)
  startedAt      DateTime   @default(now())
  endedAt        DateTime?
  duration       Int?       // seconds

  conversation Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  initiator    User              @relation(fields: [initiatorId], references: [id], onDelete: Cascade)
  participants CallParticipant[]

  @@index([conversationId])
  @@index([initiatorId])
  @@index([status])
  @@map("calls")
}

model CallParticipant {
  id       String    @id @default(uuid())
  callId   String
  userId   String
  joinedAt DateTime  @default(now())
  leftAt   DateTime?

  call Call @relation(fields: [callId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([callId])
  @@index([userId])
  @@map("call_participants")
}

// ========================================
// Notifications
// ========================================

enum NotificationType {
  MESSAGE         // ข้อความใหม่
  FRIEND_REQUEST  // คำขอเป็นเพื่อน
  FRIEND_ACCEPTED // ยอมรับคำขอ
  POST_LIKE       // กดถูกใจโพสต์
  POST_COMMENT    // คอมเมนต์โพสต์
  CALL_MISSED     // สายที่ไม่ได้รับ
  MENTION         // ถูกแท็ก
  GROUP_INVITE    // ถูกเชิญเข้ากลุ่ม
}

model Notification {
  id          String           @id @default(uuid())
  userId      String
  type        NotificationType
  title       String
  content     String           @db.Text
  isRead      Boolean          @default(false)
  relatedId   String?          // ID ของสิ่งที่เกี่ยวข้อง (messageId, postId, etc.)
  relatedType String?          // ประเภท (message, post, user, etc.)
  createdAt   DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}
